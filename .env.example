APP_NAME=Rencoderr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Disable app login when access is controlled locally or by an external service.
AUTH_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1860
HORIZON_TRANSCODE_WORKERS=1
HORIZON_QUALITY_CONTROL_WORKERS=1
QUALITY_CONTROL_TIMEOUT_SECONDS=86400
QUALITY_CONTROL_THREADS=2
QUALITY_CONTROL_MODE=sampled
QUALITY_CONTROL_SAMPLE_SECONDS=30
QUALITY_CONTROL_SAMPLE_POSITIONS=0.15,0.50,0.85
QUALITY_CONTROL_MODEL_PATH=/opt/ffmpeg/share/vmaf/vmaf_v0.6.1.json
TRANSCODE_TIMEOUT_SECONDS=604800
TRANSCODE_STAGING_DISK=transcodes
# TRANSCODE_STAGING_PATH=/absolute/path/outside/libraries

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TRANSCODE_OPTIMIZATION_CANDIDATES=8
TRANSCODE_OPTIMIZATION_SECONDS=1200
TRANSCODE_OPTIMIZATION_TEMPORARY_BYTES=4294967296
TRANSCODE_STAGING_RESERVE_BYTES=268435456
